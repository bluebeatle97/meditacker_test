# 서버 로컬 개발용 환경변수 예시 — 이 파일을 `.env` 로 복사해서 채운다.
# (config/index.ts 가 서버 시작 때 자동 로딩. 셸 환경변수가 있으면 그쪽이 이긴다.
#  Render 배포에서는 파일 대신 대시보드 환경변수를 쓴다.)

# ── 채널톡(채널 웍스) 알림 연동 ─────────────────────────────────
# 발급: 채널 데스크 → 설정 → API 키 관리 → 새 인증 정보 생성
# 손 테스트: 서버 켜고 http://localhost:8080/channeltalk-test
CHANNELTALK_ACCESS_KEY=
CHANNELTALK_ACCESS_SECRET=

# 팀챗에 찍히는 봇 이름 (기본: 메디트래커)
#CHANNELTALK_BOT_NAME=메디트래커

# 알림 보낼 팀챗 그룹 — 이름 또는 숫자 ID. 테스트 페이지의 "그룹 목록" 버튼으로 확인
#CHANNELTALK_GROUP=

# 기본 멘션·공지 대상 매니저 ID. 테스트 페이지의 "매니저 목록" 버튼으로 확인
#CHANNELTALK_MANAGER_ID=

# ── 직원용·관제 진입 (필수) ─────────────────────────────────────
# 직원용 패널(/)·관제(/monitor) 진입 핀. 이 값이 곧 '누가 전원의 위치를 볼 수 있나' 다.
# 6자리 이상 권장 — 짧으면 실패 지연·잠금이 있어도 결국 맞춰진다.
STAFF_PIN=000111

# 토큰 서명 키. 배포에서는 반드시 교체 (openssl rand -hex 32)
JWT_SECRET=dev-only-change-me

# 핀 없이 토큰을 내주는 개발 창구(GET /staff-token · /dev-token)를 강제로 켜고/끈다.
# 안 주면 NODE_ENV 로 갈린다 — 로컬은 켜짐, 배포 이미지(production)는 꺼짐.
# ⚠️ 배포에서 1 로 켜면 핀이 무의미해진다.
#DEV_TOKEN=0

# ── 테스트 장비 ────────────────────────────────────────────────
# 계획 배치 게이트웨이(GW-xx)·목업 비콘을 켠 상태로 시작할지.
# 기본(미설정)은 꺼짐 = 실장비만. 화면의 🧪 버튼으로 재시작 없이 켤 수 있다.
#TEST_GEAR=1
