# 서버 로컬 개발용 환경변수 예시 — 이 파일을 `.env` 로 복사해서 채운다.
# (config/index.ts 가 서버 시작 때 자동 로딩. 셸 환경변수가 있으면 그쪽이 이긴다.
#  Render 배포에서는 파일 대신 대시보드 환경변수를 쓴다.)

# ── 채널톡(채널 웍스) 알림 연동 ─────────────────────────────────
# 발급: 채널 데스크 → 설정 → API 키 관리 → 새 인증 정보 생성
# 손 테스트: 서버 켜고 http://localhost:8080/channeltalk-test
CHANNELTALK_ACCESS_KEY=
CHANNELTALK_ACCESS_SECRET=

# 팀챗에 찍히는 봇 이름 (기본: 메디트래커)
#CHANNELTALK_BOT_NAME=메디트래커

# 알림 보낼 팀챗 그룹 — 이름 또는 숫자 ID. 테스트 페이지의 "그룹 목록" 버튼으로 확인
#CHANNELTALK_GROUP=

# 기본 멘션·공지 대상 매니저 ID. 테스트 페이지의 "매니저 목록" 버튼으로 확인
#CHANNELTALK_MANAGER_ID=
