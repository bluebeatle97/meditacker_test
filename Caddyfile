# HTTPS 리버스 프록시 — EC2 배포에서 meditracker 앞에 세운다 (docker-compose.prod.yml).
#
# **왜 필요한가.** 두 가지다.
#   1. 진입 핀이 평문으로 날아가면 안 된다
#   2. 화면을 다른 도메인(Vercel 등)에 따로 올릴 경우, 그쪽이 https 면 브라우저가 http
#      서버로 가는 fetch·소켓을 통째로 막는다 (mixed content). 그러면 화면은 멀쩡히 뜨는데
#      데이터만 안 와서 **조용히 시연 모드로 빠진다** — 가장 알아채기 어려운 실패다
#
# 인증서는 Caddy 가 Let's Encrypt 에서 자동으로 받고 자동으로 갱신한다. 조건이 둘:
#   - 도메인 A 레코드가 이 서버(Elastic IP)를 가리키고 **전파돼 있어야** 한다
#   - 80·443 인바운드가 열려 있어야 한다 (80 은 발급 확인에 쓴다)
#
# ⚠️ 이 둘이 안 맞은 채로 컨테이너를 계속 올리면 발급 실패가 쌓여 Let's Encrypt 한도에
#    걸린다 (몇 시간~일주일). **DNS 를 먼저 확인하고 나서 올린다.**

{$SITE_DOMAIN} {
	encode zstd gzip

	# WebSocket 업그레이드는 Caddy 가 그대로 넘긴다 — 소켓(/socket.io/)도 이 경로로 지나간다.
	# 8080 은 호스트에 열지 않는다 (compose 의 expose) — 바깥에서 오는 길은 여기뿐이다.
	reverse_proxy meditracker:8080

	# 직원용·관제 접근 제어는 여기서 하지 않는다. 서버가 진입 핀을 받아 토큰을 내주고
	# (POST /staff-token), 그 토큰이 없으면 직원 전용 API·소켓이 전부 401 이다.
	# 환자용(/patient/)은 핀 없이 열려 있어야 하므로 프록시에서 한 겹 더 덮으면 안 된다.
}
