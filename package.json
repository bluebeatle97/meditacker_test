{
  "name": "meditracker",
  "private": true,
  "version": "0.1.0",
  "description": "BLE zone-based indoor RTLS for clinic (patients & staff)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:all": "node tools/dev-all.mjs",
    "dev:server": "npm run dev -w @meditracker/server",
    "dev:staff": "npm run dev -w @meditracker/web-staff",
    "dev:patient": "npm run dev -w @meditracker/web-patient",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:demo": "npm run build -w @meditracker/web-staff && npm run build -w @meditracker/web-patient",
    "start:demo": "npm run start:demo -w @meditracker/server",
    "stop": "node tools/stop-all.mjs"
  }
}
