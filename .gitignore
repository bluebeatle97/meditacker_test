node_modules/
dist/
# 빌드 때 서버 config 에서 복사해 온다 (tools/copy-demo-config.mjs) — 원본이 단일 출처
packages/*/public/config/
*.log
.env
.env.*
!.env.example
# 배포 빌드용 프론트 설정 — 비밀값 없음(서버 주소가 '같은 도메인'이라는 표시뿐)
!.env.production
# build-design-board.py 가 build-pixel-map.py 를 importlib 로 불러 쓸 때 생긴다
__pycache__/
data/*.db
data/*.db-journal
packages/server/data/
mosquitto/data/
mosquitto/log/

# 캐릭터 파츠는 커밋한다 — 유료 라이선스 보유(저장소 소유자 확인, 2026-08-09).
# 커밋하지 않으면 GitHub Actions 빌드에 폴더가 없어 manifest.json 이 404 나고
# 환자용 화면이 통째로 안 뜬다. 다시 만들려면:
#   python tools/build-charparts.py "<Character Pieces 폴더>"
