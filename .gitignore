node_modules/
dist/
# 빌드 때 서버 config 에서 복사해 온다 (tools/copy-demo-config.mjs) — 원본이 단일 출처
packages/*/public/config/
*.log
.env
.env.*
!.env.example
# 배포 빌드용 프론트 설정 — 비밀값 없음(서버 주소가 '같은 도메인'이라는 표시뿐)
!.env.production
# build-design-board.py 가 build-pixel-map.py 를 importlib 로 불러 쓸 때 생긴다
__pycache__/
data/*.db
data/*.db-journal
packages/server/data/
mosquitto/data/
mosquitto/log/

# 캐릭터 파츠 — 원본 에셋 재배포 금지라 커밋하지 않는다.
# 각 기기에서: python tools/build-charparts.py "<Character Pieces 폴더>"
packages/web-patient/public/charparts/
